  <!-- JAVASCRIPT APPLICATION LOGIC                                          -->
  <!-- ===================================================================== -->
  <script>
    /* =====================================================================
       1. STATE MANAGEMENT & LOCAL STORAGE PERSISTENCE
       ===================================================================== */
    const STORAGE_KEY = 'mpi_narrative_endang_2026_v1';

    const defaultState = {
      currentView: 'landing',
      navSequence: ['landing', 'menu', 'materi', 'simulasi', 'praktikum', 'game', 'lkpd', 'evaluasi', 'developer'],
      audioEnabled: true,
      speechRate: 1.0,
      // Progress tracking
      materiSubIndex: 0,
      materiCompleted: [false, false, false, false, false],
      materiQuizAnswers: {},
      simulasiCompleted: false,
      simulasiAnswers: {},
      praktikumSaved: {
        p1_chars: '', p1_time: '', p1_place: '',
        p2_order: '',
        p3_conflict: '',
        p4_resolution: '',
        p5_verbs: ['', '', '', ''],
        p6_title: '', p6_orientation: '', p6_complication: '', p6_resolution: '', p6_moral: ''
      },
      praktikumCompleted: false,
      gameScores: {
        g1: null, // 0-100
        g2: null,
        g3: null,
        g4: null,
        g5: null
      },
      lkpdData: {
        name: '',
        studentClass: 'XI',
        date: new Date().toISOString().split('T')[0],
        q1_chars: '',
        q2_setting: '',
        q3_m1: '', q3_m2: '', q3_m3: '', q3_m4: '',
        q4_mc: '',
        q4_verb1: '', q4_verb2: '',
        q5_moral: '',
        q6_story: '',
        checked: false,
        score: null
      },
      evalResult: null,
      reflection: {
        q1: '',
        q2: '',
        q3: '',
        confidence: 4,
        notes: '',
        saved: false
      }
    };

    let appState = loadState();

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return JSON.parse(JSON.stringify(defaultState));
        const parsed = JSON.parse(raw);
        return {
          ...JSON.parse(JSON.stringify(defaultState)),
          ...parsed,
          praktikumSaved: { ...defaultState.praktikumSaved, ...(parsed.praktikumSaved || {}) },
          gameScores: { ...defaultState.gameScores, ...(parsed.gameScores || {}) },
          lkpdData: { ...defaultState.lkpdData, ...(parsed.lkpdData || {}) },
          reflection: { ...defaultState.reflection, ...(parsed.reflection || {}) }
        };
      } catch (e) {
        return JSON.parse(JSON.stringify(defaultState));
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {
        console.warn('LocalStorage save failed:', e);
      }
      updateGlobalProgressUI();
    }

    function calculateOverallProgress() {
      let points = 0;
      const maxPoints = 100;
      // 1. Materi (25 pts -> 5 pts per sub-chapter)
      const matDone = appState.materiCompleted.filter(Boolean).length;
      points += matDone * 5;
      // 2. Simulasi (15 pts)
      if (appState.simulasiCompleted) points += 15;
      // 3. Praktikum (15 pts)
      if (appState.praktikumCompleted) points += 15;
      // 4. Games (15 pts -> 3 pts per game played)
      const gamesPlayed = Object.values(appState.gameScores).filter(v => v !== null).length;
      points += gamesPlayed * 3;
      // 5. LKPD (15 pts)
      if (appState.lkpdData.checked) points += 15;
      // 6. Evaluasi (10 pts)
      if (appState.evalResult !== null) points += 10;
      // 7. Refleksi (5 pts)
      if (appState.reflection.saved) points += 5;

      return Math.min(100, Math.round((points / maxPoints) * 100));
    }

    function updateGlobalProgressUI() {
      const pct = calculateOverallProgress();
      const bar = document.getElementById('global-progress-bar');
      const txt = document.getElementById('global-progress-text');
      if (bar) bar.style.width = pct + '%';
      if (txt) txt.textContent = pct + '%';
    }

    /* =====================================================================
       2. UI UTILITIES: TOAST & MODAL CONFIRMATION
       ===================================================================== */
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const colors = {
        success: 'bg-emerald-600 text-white border-emerald-400',
        error: 'bg-rose-600 text-white border-rose-400',
        warning: 'bg-amber-500 text-navy-950 border-amber-300',
        info: 'bg-navy-800 text-white border-royal-500'
      };
      const icons = { success: '✅', error: '❌', warning: '⚠️', info: '✨' };
      const toast = document.createElement('div');
      toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl shadow-xl border text-sm font-semibold page-enter ${colors[type] || colors.info}`;
      toast.innerHTML = `<span>${icons[type] || '✨'}</span><span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    function showConfirm(title, message, onConfirm) {
      const modal = document.getElementById('confirm-modal');
      document.getElementById('confirm-title').textContent = title;
      document.getElementById('confirm-message').textContent = message;
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      const cleanup = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      document.getElementById('confirm-cancel-btn').onclick = cleanup;
      document.getElementById('confirm-ok-btn').onclick = () => {
        cleanup();
        onConfirm();
      };
    }

    /* =====================================================================
       3. AUDIO ENGINE: WEB SPEECH API & WEB AUDIO API SOUND EFFECTS
       ===================================================================== */
    const speechSupported = 'speechSynthesis' in window;
    let currentUtterance = null;
    let lastSpokenConfig = null;
    let sentenceTimer = null;

    if (!speechSupported) {
      window.addEventListener('DOMContentLoaded', () => {
        const banner = document.getElementById('speech-fallback-banner');
        if (banner) banner.classList.remove('hidden');
      });
    }

    // Web Audio API Synthesized Sound Effects
    let audioCtx = null;
    function getAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) audioCtx = new AudioContextClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playSFX(type) {
      if (!appState.audioEnabled) return;
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;

        if (type === 'correct') {
          // Cheerful ascending major triad chime
          [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now + idx * 0.08);
            gain.gain.setValueAtTime(0.16, now + idx * 0.08);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.35);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + idx * 0.08);
            osc.stop(now + idx * 0.08 + 0.36);
          });
        } else if (type === 'wrong') {
          // Gentle low double-tone
          [260, 210].forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now + idx * 0.14);
            gain.gain.setValueAtTime(0.15, now + idx * 0.14);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.14 + 0.28);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + idx * 0.14);
            osc.stop(now + idx * 0.14 + 0.3);
          });
        } else if (type === 'win') {
          // Victory fanfare
          const notes = [523.25, 659.25, 783.99, 1046.5, 783.99, 1046.5];
          const times = [0, 0.1, 0.2, 0.32, 0.48, 0.6];
          notes.forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now + times[idx]);
            gain.gain.setValueAtTime(0.18, now + times[idx]);
            gain.gain.exponentialRampToValueAtTime(0.001, now + times[idx] + 0.4);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now + times[idx]);
            osc.stop(now + times[idx] + 0.42);
          });
        } else if (type === 'click') {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(600, now);
          gain.gain.setValueAtTime(0.06, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.07);
        }
      } catch (e) {
        // Ignore audio context errors silently
      }
    }

    function toggleGlobalAudio() {
      appState.audioEnabled = !appState.audioEnabled;
      if (!appState.audioEnabled) {
        stopSpeech();
      }
      updateAudioButtonUI();
      saveState();
      showToast(appState.audioEnabled ? 'Audio diaktifkan (ON)' : 'Audio dinonaktifkan (OFF)', 'info');
    }

    function updateAudioButtonUI() {
      const btn = document.getElementById('global-audio-btn');
      const icon = document.getElementById('global-audio-icon');
      const label = document.getElementById('global-audio-label');
      const rateSel = document.getElementById('global-speech-rate');
      if (rateSel) rateSel.value = String(appState.speechRate);
      if (!btn) return;
      if (appState.audioEnabled) {
        btn.className = 'px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold flex items-center gap-1.5 shadow transition';
        icon.textContent = '🔊';
        label.textContent = 'Audio ON';
      } else {
        btn.className = 'px-3 py-2 rounded-xl bg-slate-700 hover:bg-slate-600 text-slate-300 text-xs font-bold flex items-center gap-1.5 shadow transition';
        icon.textContent = '🔇';
        label.textContent = 'Audio OFF';
      }
    }

    function setSpeechRate(val) {
      appState.speechRate = parseFloat(val) || 1.0;
      saveState();
      showToast(`Kecepatan suara: ${appState.speechRate}x`, 'info');
    }

    function getBestVoice(langCode) {
      if (!speechSupported) return null;
      const voices = window.speechSynthesis.getVoices();
      if (!voices || !voices.length) return null;
      const exact = voices.find(v => v.lang.toLowerCase() === langCode.toLowerCase());
      if (exact) return exact;
      const prefix = langCode.split('-')[0].toLowerCase();
      return voices.find(v => v.lang.toLowerCase().startsWith(prefix)) || null;
    }

    if (speechSupported && window.speechSynthesis.onvoiceschanged !== undefined) {
      window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
    }

    function clearSentenceHighlights() {
      if (sentenceTimer) {
        clearInterval(sentenceTimer);
        sentenceTimer = null;
      }
      document.querySelectorAll('.sentence-active').forEach(el => el.classList.remove('sentence-active'));
    }

    function speakText(text, lang = 'en-US', highlightContainerId = null) {
      if (!appState.audioEnabled) {
        showToast('Audio sedang OFF. Aktifkan tombol Audio ON di bagian atas.', 'warning');
        return;
      }
      if (!speechSupported) {
        showToast('Browser Anda tidak mendukung Text-to-Speech.', 'warning');
        return;
      }

      stopSpeech();
      lastSpokenConfig = { text, lang, highlightContainerId };

      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = lang;
      utter.rate = appState.speechRate;
      const voice = getBestVoice(lang);
      if (voice) utter.voice = voice;

      // Optional sentence-by-sentence visual highlight for Simulation story
      if (highlightContainerId) {
        const container = document.getElementById(highlightContainerId);
        if (container) {
          const spans = container.querySelectorAll('.story-sentence');
          if (spans.length > 0) {
            let idx = 0;
            spans[0].classList.add('sentence-active');
            const totalWords = text.split(/\s+/).length;
            const estTotalMs = (totalWords / (2.5 * appState.speechRate)) * 1000;
            const stepMs = Math.max(1200, estTotalMs / spans.length);
            sentenceTimer = setInterval(() => {
              spans.forEach(s => s.classList.remove('sentence-active'));
              idx++;
              if (idx < spans.length) {
                spans[idx].classList.add('sentence-active');
              } else {
                clearInterval(sentenceTimer);
              }
            }, stepMs);
          }
        }
      }

      utter.onend = () => {
        clearSentenceHighlights();
      };
      utter.onerror = () => {
        clearSentenceHighlights();
      };

      currentUtterance = utter;
      window.speechSynthesis.speak(utter);
    }

    function pauseSpeech() {
      if (speechSupported && window.speechSynthesis.speaking && !window.speechSynthesis.paused) {
        window.speechSynthesis.pause();
        showToast('Suara dijeda (Paused)', 'info');
      }
    }

    function resumeSpeech() {
      if (speechSupported && window.speechSynthesis.paused) {
        window.speechSynthesis.resume();
        showToast('Suara dilanjutkan (Resumed)', 'info');
      }
    }

    function stopSpeech() {
      clearSentenceHighlights();
      if (speechSupported) {
        window.speechSynthesis.cancel();
      }
    }

    function replaySpeech() {
      if (lastSpokenConfig) {
        speakText(lastSpokenConfig.text, lastSpokenConfig.lang, lastSpokenConfig.highlightContainerId);
      } else {
        showToast('Belum ada audio yang diputar sebelumnya.', 'info');
      }
    }

