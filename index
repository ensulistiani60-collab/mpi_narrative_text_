              <h3 class="text-lg font-extrabold text-navy-900">✍️ Jawaban Tugas Menulis (Soal #26) & Rubrik Penilaian Guru</h3>
              <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold">Dinilai Manual oleh Guru</span>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-sm text-slate-800 whitespace-pre-line">
              ${res.writingResponse ? escapeHtml(res.writingResponse) : '<span class="italic text-slate-400">(Siswa belum mengisi jawaban tugas menulis)</span>'}
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="bg-royal-900 text-white">
                    <th class="p-2.5 border border-royal-700">Kriteria Rubrik</th>
                    <th class="p-2.5 border border-royal-700">Bobot</th>
                    <th class="p-2.5 border border-royal-700">Indikator Penilaian Guru</th>
                  </tr>
                </thead>
                <tbody class="text-slate-700">
                  <tr>
                    <td class="p-2.5 border border-slate-200 font-bold">1. Kelengkapan Generic Structure</td>
                    <td class="p-2.5 border border-slate-200">35%</td>
                    <td class="p-2.5 border border-slate-200">Memuat Orientation, Complication, dan Resolution secara logis & padu.</td>
                  </tr>
                  <tr>
                    <td class="p-2.5 border border-slate-200 font-bold">2. Ketepatan Simple Past Tense</td>
                    <td class="p-2.5 border border-slate-200">35%</td>
                    <td class="p-2.5 border border-slate-200">Penggunaan Verb 2, Action Verbs, dan Time Connectives akurat.</td>
                  </tr>
                  <tr>
                    <td class="p-2.5 border border-slate-200 font-bold">3. Orisinalitas & Moral Value</td>
                    <td class="p-2.5 border border-slate-200">30%</td>
                    <td class="p-2.5 border border-slate-200">Alur cerita kreatif serta menyampaikan pesan moral yang jelas.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Full Discussion for Q1 - Q25 -->
          <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-md space-y-5">
            <h3 class="text-xl font-bold text-navy-900">📖 Pembahasan Soal Objektif (Nomor 1 – 25)</h3>
            <div class="space-y-4">
              ${EVAL_QUESTIONS.filter(q => q.type !== 'writing').map(q => {
                const userRaw = String(evalState.answers[q.num] || '').trim();
                let isCorrect = false;
                if (q.type === 'short') {
                  isCorrect = q.keywords.some(kw => userRaw.toLowerCase().includes(kw.toLowerCase()));
                } else {
                  isCorrect = userRaw.toLowerCase() === q.answer.toLowerCase();
                }
                const correctDisplay = q.type === 'short' ? q.sampleAnswer : q.answer;
                return `
                  <div class="p-4 rounded-2xl border ${isCorrect ? 'bg-emerald-50/50 border-emerald-200' : 'bg-rose-50/50 border-rose-200'} space-y-2">
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-xs font-extrabold px-2.5 py-0.5 rounded-lg ${isCorrect ? 'bg-emerald-600 text-white' : 'bg-rose-600 text-white'}">
                        Soal #${q.num} • ${isCorrect ? 'BENAR' : 'KURANG TEPAT'}
                      </span>
                      <span class="text-xs text-slate-500 font-semibold">${q.level}</span>
                    </div>
                    <p class="text-sm font-bold text-navy-900">${q.question}</p>
                    <div class="text-xs flex flex-wrap gap-4">
                      <span>Jawaban Kamu: <strong class="${isCorrect ? 'text-emerald-700' : 'text-rose-700'}">${userRaw || '(Kosong)'}</strong></span>
                      <span>Kunci Jawaban: <strong class="text-emerald-800">${correctDisplay}</strong></span>
                    </div>
                    <p class="text-xs text-slate-600 bg-white p-2.5 rounded-xl border border-slate-200">
                      <strong>Pembahasan:</strong> ${q.explanation}
                    </p>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        </div>
      `;
    }

    /* =====================================================================
       14. VIEW 8: MENU 7 - PENGEMBANG & REFLEKSI SISWA
       ===================================================================== */
