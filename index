          <!-- Student Reflection Form (4 Mandatory Questions) -->
          <div id="reflection-section" class="bg-white rounded-3xl border-2 border-royal-300 p-6 sm:p-8 shadow-lg space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 pb-4">
              <div>
                <span class="text-xs font-extrabold uppercase text-royal-700">Student Self-Reflection</span>
                <h3 class="text-xl sm:text-2xl font-bold text-navy-900">Lembar Refleksi Pembelajaran Siswa</h3>
