    function finalizeEvalSubmission() {
      if (evalState.timerInterval) clearInterval(evalState.timerInterval);
      evalState.submitted = true;

      let correctCount = 0;
      const details = [];

      EVAL_QUESTIONS.forEach(q => {
        if (q.type === 'writing') return;
        const userRaw = String(evalState.answers[q.num] || '').trim();
        let isCorrect = false;

        if (q.type === 'mc' || q.type === 'tf' || q.type === 'match') {
          isCorrect = userRaw.toLowerCase() === q.answer.toLowerCase();
        } else if (q.type === 'short') {
          const low = userRaw.toLowerCase();
          isCorrect = q.keywords.some(kw => low.includes(kw.toLowerCase()));
        }

        if (isCorrect) correctCount++;
        details.push({ num: q.num, isCorrect, userRaw });
      });

      const percentage = Math.round((correctCount / 25) * 100);
      appState.evalResult = {
        correctCount,
        totalObjective: 25,
        percentage,
        writingResponse: evalState.answers[26] || '',
        date: new Date().toLocaleDateString('id-ID')
      };
      saveState();
      playSFX(percentage >= 75 ? 'win' : 'correct');
      renderCurrentView();
    }

