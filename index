                      </div>

                      <!-- Indonesian Translation -->
                      ${showSimTranslation ? `
                        <div class="bg-royal-50/70 border-l-4 border-royal-600 p-3.5 rounded-r-xl text-xs sm:text-sm text-slate-700 leading-relaxed">
