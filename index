        snippet: 'An old father asked his quarreling sons to break a bundle of tied sticks. None could break it. When untied, each stick broke easily.',
        options: [
          'Wooden sticks are stronger in winter.',
          'Unity and teamwork give us unbreakable strength.',
          'Fathers should keep sticks inside the house.'
        ],
        answer: 1
      }
    ];

    function renderGameHubView() {
      if (activeGameId === 'g1') return renderGame1Puzzle();
      if (activeGameId === 'g2') return renderGame2Character();
      if (activeGameId === 'g3') return renderGame3WordHunter();
      if (activeGameId === 'g4') return renderGame4Challenge();
      if (activeGameId === 'g5') return renderGame5MoralQuest();

      const games = [
        { id: 'g1', num: 'GAME 1', title: 'STORY PUZZLE', desc: 'Susun 4 paragraf acak menjadi urutan Generic Structure yang tepat.', icon: '🧩', color: 'from-sky-600 to-navy-900' },
        { id: 'g2', num: 'GAME 2', title: 'GUESS THE CHARACTER', desc: 'Tebak tokoh legenda, fabel, & dongeng dari 3 petunjuk bertahap.', icon: '🎭', color: 'from-royal-600 to-royal-900' },
        { id: 'g3', num: 'GAME 3', title: 'WORD HUNTER', desc: 'Temukan & klik 8 kata kerja Simple Past Tense (Verb 2) dalam cerita.', icon: '🔍', color: 'from-emerald-600 to-navy-900' },
        { id: 'g4', num: 'GAME 4', title: 'STORY CHALLENGE', desc: 'Tantangan 6 soal cepat seputar Narrative Text dengan bonus kombo.', icon: '⚡', color: 'from-amber-500 to-orange-700' },
        { id: 'g5', num: 'GAME 5', title: 'MORAL VALUE QUEST', desc: 'Analisis 4 kutipan cerita inspiratif dan temukan pesan moral terbaik.', icon: '🌟', color: 'from-purple-600 to-navy-900' }
      ];

      const totalAvg = calculateAverageGameScore();

      return `
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 page-enter">
          <div class="bg-gradient-to-r from-purple-900 via-royal-900 to-navy-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-8 flex flex-wrap items-center justify-between gap-4">
            <div>
              <span class="px-3 py-1 rounded-full bg-gold-500/20 text-gold-300 border border-gold-400/30 text-xs font-bold">
                MENU 4 • EDUCATIVE GAME ARENA
              </span>
              <h2 class="font-serif text-2xl sm:text-4xl font-bold mt-2">Narrative Game Zone</h2>
              <p class="text-slate-300 text-xs sm:text-sm mt-1">Mainkan 5 game interaktif untuk mengasah pemahamanmu dan kumpulkan bintang penghargaan!</p>
            </div>
            <div class="bg-white/10 border border-white/15 rounded-2xl px-5 py-3 text-center">
              <p class="text-xs text-gold-300 font-bold uppercase">Rata-Rata Skor Game</p>
              <p class="text-2xl font-extrabold text-white">${totalAvg}%</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            ${games.map(g => {
              const sc = appState.gameScores[g.id];
              const stars = sc === null ? 0 : sc >= 85 ? 3 : sc >= 60 ? 2 : 1;
              return `
                <div class="bg-white rounded-3xl border border-slate-200 shadow-md overflow-hidden flex flex-col justify-between hover:shadow-xl transition">
                  <div>
                    <div class="bg-gradient-to-br ${g.color} p-6 text-white">
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-extrabold px-2.5 py-1 rounded-lg bg-black/25 text-gold-300">${g.num}</span>
                        <span class="text-4xl">${g.icon}</span>
                      </div>
                      <h3 class="text-xl font-extrabold mt-4">${g.title}</h3>
                    </div>
                    <div class="p-5 space-y-3">
                      <p class="text-slate-600 text-sm leading-relaxed">${g.desc}</p>
                      <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                        <span class="text-xs font-bold text-slate-500">
                          ${sc !== null ? `Skor Terbaik: <strong class="text-royal-700">${sc}/100</strong>` : 'Belum dimainkan'}
                        </span>
                        <span class="text-sm">${'⭐'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>
                      </div>
                    </div>
                  </div>
                  <div class="px-5 pb-5">
                    <button onclick="startMiniGame('${g.id}')" class="w-full py-3 rounded-xl bg-royal-700 hover:bg-royal-800 text-white font-bold text-sm shadow transition">
                      ▶ Play ${g.title}
                    </button>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    function calculateAverageGameScore() {
      const vals = Object.values(appState.gameScores).filter(v => v !== null);
      if (!vals.length) return 0;
      return Math.round(vals.reduce((a, b) => a + b, 0) / vals.length);
    }

    function startMiniGame(id) {
      playSFX('click');
      activeGameId = id;
      if (id === 'g1') {
        g1Blocks = [...G1_CORRECT_ORDER].sort(() => Math.random() - 0.5);
        if (g1Blocks.every((b, i) => b.id === G1_CORRECT_ORDER[i].id)) {
          g1Blocks.reverse();
        }
      } else if (id === 'g2') {
        g2State = { round: 0, clueStep: 1, score: 0, answered: false };
      } else if (id === 'g3') {
        g3State = { found: [], mistakes: 0, finished: false };
      } else if (id === 'g4') {
        g4State = { idx: 0, score: 0, streak: 0, answered: false };
      } else if (id === 'g5') {
        g5State = { idx: 0, score: 0, answered: false };
      }
      renderCurrentView();
    }

    function exitMiniGame() {
      activeGameId = null;
      renderCurrentView();
    }

    function renderGameResultModalHTML(title, score, detailText, gameId) {
      const stars = score >= 85 ? 3 : score >= 60 ? 2 : 1;
      return `
        <div class="bg-gradient-to-br from-navy-900 to-royal-900 text-white rounded-3xl p-6 sm:p-8 text-center space-y-4 border-2 border-gold-400 shadow-2xl page-enter">
          <div class="text-4xl sm:text-5xl tracking-widest">${'⭐'.repeat(stars)}${'☆'.repeat(3 - stars)}</div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-gold-300">${title} Complete!</h3>
          <p class="text-4xl font-extrabold text-white">${score} <span class="text-base font-normal text-slate-300">/ 100</span></p>
          <p class="text-sm text-slate-200 max-w-md mx-auto">${detailText}</p>
          <div class="flex flex-wrap justify-center gap-3 pt-3">
            <button onclick="startMiniGame('${gameId}')" class="px-5 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-400 text-navy-950 font-extrabold text-sm shadow transition">
              🔄 Play Again
            </button>
            <button onclick="exitMiniGame()" class="px-5 py-2.5 rounded-xl bg-white/15 hover:bg-white/25 text-white font-bold text-sm transition">
              ← Kembali ke Daftar Game
            </button>
          </div>
        </div>
      `;
    }

    // --- GAME 1: STORY PUZZLE ---
    let g1ResultHTML = '';
    function renderGame1Puzzle() {
      return `
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 page-enter space-y-6">
          <div class="flex items-center justify-between">
            <button onclick="exitMiniGame()" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-700 hover:bg-slate-100">← Daftar Game</button>
            <span class="px-3 py-1 rounded-full bg-sky-100 text-sky-900 text-xs font-extrabold">GAME 1: STORY PUZZLE</span>
          </div>

          <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-lg space-y-5">
            <div>
              <h3 class="text-xl sm:text-2xl font-bold text-navy-900">Susun Urutan Generic Structure Cerita</h3>
              <p class="text-xs sm:text-sm text-slate-600">Gunakan tombol <strong>▲ Naik</strong> atau <strong>▼ Turun</strong> untuk menyusun 4 potongan cerita dari urutan #1 (Orientation) hingga #4 (Reorientation/Coda).</p>
            </div>

            <div class="space-y-3">
              ${g1Blocks.map((b, i) => `
                <div class="flex items-center gap-3 bg-slate-50 border border-slate-300 rounded-2xl p-4">
                  <div class="w-9 h-9 rounded-xl bg-royal-700 text-white font-extrabold flex items-center justify-center shrink-0">
                    #${i + 1}
                  </div>
                  <p class="flex-1 text-sm text-slate-800 leading-relaxed">${b.text}</p>
                  <div class="flex flex-col gap-1 shrink-0">
                    <button onclick="moveG1Block(${i}, -1)" ${i === 0 ? 'disabled' : ''} class="px-2.5 py-1 rounded-lg bg-white border border-slate-300 text-xs font-bold hover:bg-royal-50 disabled:opacity-30">▲</button>
                    <button onclick="moveG1Block(${i}, 1)" ${i === g1Blocks.length - 1 ? 'disabled' : ''} class="px-2.5 py-1 rounded-lg bg-white border border-slate-300 text-xs font-bold hover:bg-royal-50 disabled:opacity-30">▼</button>
                  </div>
                </div>
              `).join('')}
            </div>

            <div class="flex justify-end">
              <button onclick="checkGame1Puzzle()" class="px-6 py-3 rounded-xl bg-royal-700 hover:bg-royal-800 text-white font-bold text-sm shadow transition">
                ✅ Periksa Susunan Puzzle
              </button>
            </div>
          </div>

          ${g1ResultHTML}
        </div>
      `;
    }

    function moveG1Block(idx, dir) {
      const target = idx + dir;
      if (target < 0 || target >= g1Blocks.length) return;
      playSFX('click');
      const temp = g1Blocks[idx];
      g1Blocks[idx] = g1Blocks[target];
      g1Blocks[target] = temp;
      renderCurrentView();
    }

    function checkGame1Puzzle() {
      let correctPositions = 0;
      g1Blocks.forEach((b, i) => {
        if (b.id === G1_CORRECT_ORDER[i].id) correctPositions++;
      });
      const score = correctPositions * 25;
      appState.gameScores.g1 = Math.max(appState.gameScores.g1 || 0, score);
      saveState();

      if (score === 100) playSFX('win');
      else if (score >= 50) playSFX('correct');
      else playSFX('wrong');

      g1ResultHTML = renderGameResultModalHTML(
        'Story Puzzle',
        score,
        `Kamu menempatkan ${correctPositions} dari 4 bagian cerita pada urutan Generic Structure yang benar (Orientation → Complication → Resolution → Coda).`,
        'g1'
      );
      renderCurrentView();
    }

    // --- GAME 2: GUESS THE CHARACTER ---
    function renderGame2Character() {
      if (g2State.round >= G2_ROUNDS.length) {
        const finalScore = Math.round((g2State.score / G2_ROUNDS.length) * 100);
        appState.gameScores.g2 = Math.max(appState.gameScores.g2 || 0, finalScore);
        saveState();
        return `
          <div class="max-w-3xl mx-auto px-4 py-8">
            ${renderGameResultModalHTML('Guess The Character', finalScore, `Kamu berhasil menebak ${g2State.score} dari ${G2_ROUNDS.length} tokoh cerita dengan tepat!`, 'g2')}
          </div>
        `;
      }

      const item = G2_ROUNDS[g2State.round];
      return `
        <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 page-enter space-y-6">
          <div class="flex items-center justify-between">
            <button onclick="exitMiniGame()" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-700">← Daftar Game</button>
            <span class="px-3 py-1 rounded-full bg-royal-100 text-royal-900 text-xs font-extrabold">GAME 2 • RONDE ${g2State.round + 1}/${G2_ROUNDS.length} • SKOR: ${g2State.score}</span>
          </div>

          <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-lg space-y-5">
            <h3 class="text-xl font-bold text-navy-900">🎭 Siapakah Tokoh Cerita Ini?</h3>
            <div class="space-y-2.5">
              ${item.clues.slice(0, g2State.clueStep).map(c => `
                <div class="bg-gold-50 border border-gold-300 rounded-xl p-3.5 text-sm font-medium text-navy-900 page-enter">
                  💡 ${c}
                </div>
              `).join('')}
            </div>

            ${g2State.clueStep < 3 && !g2State.answered ? `
              <button onclick="revealG2Clue()" class="px-4 py-2 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 text-xs font-bold transition">
                + Buka Petunjuk Berikutnya (${g2State.clueStep}/3)
              </button>
            ` : ''}

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              ${item.options.map((opt, idx) => `
                <button onclick="answerG2(${idx})" ${g2State.answered ? 'disabled' : ''} class="p-4 rounded-2xl border-2 text-left font-bold text-sm transition ${
                  g2State.answered
                    ? idx === item.answer
                      ? 'bg-emerald-600 border-emerald-600 text-white'
                      : 'bg-slate-100 border-slate-200 text-slate-400'
                    : 'bg-white hover:bg-royal-50 border-slate-200 hover:border-royal-500 text-navy-900'
                }">
                  ${opt}
                </button>
              `).join('')}
            </div>

            ${g2State.answered ? `
              <div class="flex justify-end pt-2">
                <button onclick="nextG2Round()" class="px-6 py-2.5 rounded-xl bg-royal-700 text-white font-bold text-sm">
                  Ronde Berikutnya →
                </button>
              </div>
            ` : ''}
          </div>
        </div>
      `;
    }

    function revealG2Clue() {
      if (g2State.clueStep < 3) {
        playSFX('click');
        g2State.clueStep++;
        renderCurrentView();
      }
    }

    function answerG2(idx) {
      if (g2State.answered) return;
      g2State.answered = true;
      if (idx === G2_ROUNDS[g2State.round].answer) {
        g2State.score++;
        playSFX('correct');
        showToast('Tebakan benar!', 'success');
      } else {
        playSFX('wrong');
        showToast('Kurang tepat!', 'error');
      }
      renderCurrentView();
    }

    function nextG2Round() {
      g2State.round++;
      g2State.clueStep = 1;
      g2State.answered = false;
      if (g2State.round >= G2_ROUNDS.length) playSFX('win');
      renderCurrentView();
    }

    // --- GAME 3: WORD HUNTER ---
    function renderGame3WordHunter() {
      const totalVerbs = 8;
      if (g3State.finished) {
        const rawScore = Math.max(0, Math.round(((g3State.found.length / totalVerbs) * 100) - (g3State.mistakes * 10)));
        appState.gameScores.g3 = Math.max(appState.gameScores.g3 || 0, rawScore);
        saveState();
        return `
          <div class="max-w-3xl mx-auto px-4 py-8">
            ${renderGameResultModalHTML('Word Hunter', rawScore, `Kamu menemukan ${g3State.found.length} dari 8 kata kerja Simple Past Tense (Verb 2) dengan ${g3State.mistakes} salah klik.`, 'g3')}
          </div>
        `;
      }

      return `
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 page-enter space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <button onclick="exitMiniGame()" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-700">← Daftar Game</button>
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-extrabold">Verb 2 Ditemukan: ${g3State.found.length}/8</span>
              <span class="px-3 py-1 rounded-full bg-rose-100 text-rose-900 text-xs font-extrabold">Nyawa Salah: ${3 - g3State.mistakes}/3</span>
            </div>
          </div>

          <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-lg space-y-5">
            <div>
              <h3 class="text-xl font-bold text-navy-900">🔍 Word Hunter: Temukan 8 Kata Kerja Simple Past Tense (Verb 2)</h3>
              <p class="text-xs sm:text-sm text-slate-600">Klik semua kata kerja bentuk lampau (Verb 2) di dalam paragraf cerita di bawah ini!</p>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 sm:p-6 leading-loose text-base sm:text-lg font-serif flex flex-wrap gap-2">
              ${G3_TOKENS.map((tok, i) => {
                const isFound = g3State.found.includes(i);
                return `
                  <button onclick="clickG3Word(${i})" class="px-2.5 py-1 rounded-xl border transition ${
                    isFound
                      ? 'bg-emerald-600 border-emerald-600 text-white font-bold shadow'
                      : 'bg-white hover:bg-gold-100 border-slate-200 text-navy-900'
                  }">
                    ${tok.word}
                  </button>
                `;
              }).join('')}
            </div>
          </div>
        </div>
      `;
    }

    function clickG3Word(idx) {
      if (g3State.finished || g3State.found.includes(idx)) return;
      const tok = G3_TOKENS[idx];
      if (tok.isVerb2) {
        g3State.found.push(idx);
        playSFX('correct');
        if (g3State.found.length === 8) {
          g3State.finished = true;
          playSFX('win');
        }
      } else {
        g3State.mistakes++;
        playSFX('wrong');
        showToast(`"${tok.word}" bukan Verb 2!`, 'error');
        if (g3State.mistakes >= 3) {
          g3State.finished = true;
        }
      }
      renderCurrentView();
    }

    // --- GAME 4: STORY CHALLENGE ---
    function renderGame4Challenge() {
      if (g4State.idx >= G4_QUESTIONS.length) {
        const finalScore = Math.min(100, Math.round((g4State.score / G4_QUESTIONS.length) * 100));
        appState.gameScores.g4 = Math.max(appState.gameScores.g4 || 0, finalScore);
        saveState();
        return `
          <div class="max-w-3xl mx-auto px-4 py-8">
            ${renderGameResultModalHTML('Story Challenge', finalScore, `Kamu menjawab ${g4State.score} dari ${G4_QUESTIONS.length} tantangan dengan tepat!`, 'g4')}
          </div>
        `;
      }

      const q = G4_QUESTIONS[g4State.idx];
      return `
        <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 page-enter space-y-6">
          <div class="flex items-center justify-between">
            <button onclick="exitMiniGame()" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-700">← Daftar Game</button>
            <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-extrabold">SOAL ${g4State.idx + 1}/${G4_QUESTIONS.length} • STREAK: 🔥${g4State.streak}</span>
          </div>

          <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-lg space-y-5">
            <h3 class="text-lg sm:text-xl font-bold text-navy-900">⚡ ${q.q}</h3>
            <div class="space-y-3">
              ${q.options.map((opt, idx) => `
                <button onclick="answerG4(${idx})" class="w-full text-left p-4 rounded-2xl border-2 border-slate-200 hover:border-royal-500 hover:bg-royal-50 font-semibold text-sm transition">
                  <span class="font-extrabold text-royal-700 mr-2">${String.fromCharCode(65 + idx)}.</span> ${opt}
                </button>
              `).join('')}
            </div>
          </div>
        </div>
      `;
    }

    function answerG4(idx) {
      const q = G4_QUESTIONS[g4State.idx];
      if (idx === q.answer) {
        g4State.score++;
        g4State.streak++;
        playSFX('correct');
        showToast('Benar! +1 Poin', 'success');
      } else {
        g4State.streak = 0;
        playSFX('wrong');
        showToast('Kurang tepat!', 'error');
      }
      g4State.idx++;
      if (g4State.idx >= G4_QUESTIONS.length) playSFX('win');
      renderCurrentView();
    }

    // --- GAME 5: MORAL VALUE QUEST ---
    function renderGame5MoralQuest() {
      if (g5State.idx >= G5_QUESTS.length) {
        const finalScore = Math.round((g5State.score / G5_QUESTS.length) * 100);
        appState.gameScores.g5 = Math.max(appState.gameScores.g5 || 0, finalScore);
        saveState();
        return `
          <div class="max-w-3xl mx-auto px-4 py-8">
            ${renderGameResultModalHTML('Moral Value Quest', finalScore, `Kamu menemukan ${g5State.score} dari ${G5_QUESTS.length} pesan moral cerita dengan akurat!`, 'g5')}
          </div>
        `;
      }

      const item = G5_QUESTS[g5State.idx];
      return `
        <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 page-enter space-y-6">
          <div class="flex items-center justify-between">
            <button onclick="exitMiniGame()" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-700">← Daftar Game</button>
            <span class="px-3 py-1 rounded-full bg-purple-100 text-purple-900 text-xs font-extrabold">QUEST ${g5State.idx + 1}/${G5_QUESTS.length} • SKOR: ${g5State.score}</span>
          </div>

          <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-lg space-y-5">
            <div>
              <span class="text-xs font-extrabold uppercase text-royal-700">Story Snippet</span>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-navy-900">${item.title}</h3>
            </div>
            <p class="bg-slate-50 border-l-4 border-gold-500 p-4 rounded-r-xl font-serif italic text-sm sm:text-base text-slate-800 leading-relaxed">
              "${item.snippet}"
            </p>
            <p class="text-xs sm:text-sm font-bold text-slate-700">Pilih pesan moral (Moral Value) paling tepat:</p>
            <div class="space-y-3">
              ${item.options.map((opt, idx) => `
                <button onclick="answerG5(${idx})" class="w-full text-left p-4 rounded-2xl border-2 border-slate-200 hover:border-royal-500 hover:bg-royal-50 text-sm font-medium transition">
                  ${opt}
                </button>
              `).join('')}
            </div>
          </div>
        </div>
      `;
    }

    function answerG5(idx) {
      if (idx === G5_QUESTS[g5State.idx].answer) {
        g5State.score++;
        playSFX('correct');
        showToast('Pesan moral tepat!', 'success');
      } else {
        playSFX('wrong');
        showToast('Coba cermati kembali pesan ceritanya.', 'error');
      }
      g5State.idx++;
      if (g5State.idx >= G5_QUESTS.length) playSFX('win');
      renderCurrentView();
    }

    /* =====================================================================
