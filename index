    function checkPraktikumAnswers() {
      syncPraktikumInputs(true);
      const p = appState.praktikumSaved;
      let score = 0;
      const notes = [];

      // Check P1
      const cOk = p.p1_chars.toLowerCase().includes('sri tanjung') || p.p1_chars.toLowerCase().includes('princess');
      const tOk = p.p1_time.toLowerCase().includes('morning');
      const plOk = p.p1_place.toLowerCase().includes('banyuwangi') || p.p1_place.toLowerCase().includes('river');
      if (cOk && tOk && plOk) {
        score += 20;
        notes.push('✅ Praktikum 1 (Tokoh & Latar): Tepat sekali!');
      } else {
        notes.push('⚠️ Praktikum 1: Pastikan tokoh (Princess Sri Tanjung), waktu (One misty morning), dan tempat (Banyuwangi / crystal river) terisi tepat.');
      }

      // Check P2, P3, P4
      if (p.p2_order === 'B') { score += 15; notes.push('✅ Praktikum 2 (Orientation): Benar (Opsi B).'); }
      else notes.push('❌ Praktikum 2: Jawaban tepat adalah B (memperkenalkan tokoh, waktu, dan tempat).');

      if (p.p3_conflict === 'B') { score += 15; notes.push('✅ Praktikum 3 (Complication): Benar (Opsi B).'); }
      else notes.push('❌ Praktikum 3: Jawaban tepat adalah B (munculnya masalah pencurian buku resep).');

      if (p.p4_resolution === 'A') { score += 15; notes.push('✅ Praktikum 4 (Resolution): Benar (Opsi A).'); }
      else notes.push('❌ Praktikum 4: Jawaban tepat adalah A (penyelesaian konflik secara adil).');

      // Check P5 Verbs
      const expectedVerbs = ['walked', 'found', 'helped', 'gave'];
      let verbHits = 0;
      expectedVerbs.forEach((ev, idx) => {
        if ((p.p5_verbs[idx] || '').trim().toLowerCase() === ev) verbHits++;
      });
      score += verbHits * 5;
      notes.push(`${verbHits === 4 ? '✅' : '💡'} Praktikum 5 (Verb 2): ${verbHits}/4 benar (Kunci: walked, found, helped, gave).`);

      // Check P6 Story Completeness
      const hasStory = p.p6_title.trim().length > 2 && p.p6_orientation.trim().length > 10 && p.p6_complication.trim().length > 10 && p.p6_resolution.trim().length > 10;
      if (hasStory) {
        score += 15;
        notes.push('✅ Praktikum 6 (Menulis Cerita): Struktur cerita lengkap! Kamu bisa membacakannya menggunakan tombol audio setelah disimpan.');
      } else {
        notes.push('💡 Praktikum 6: Lengkapi Title, Orientation, Complication, dan Resolution minimal 1 kalimat setiap bagian.');
      }

      if (score >= 70) playSFX('correct');
      else playSFX('wrong');

      praktikumFeedbackHTML = `
        <div class="bg-royal-50 border border-royal-300 rounded-2xl p-4 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-extrabold text-royal-900 text-sm">Hasil Pemeriksaan Praktikum</span>
            <span class="px-3 py-1 rounded-full bg-royal-700 text-white text-xs font-bold">Skor Latihan: ${score}/100</span>
          </div>
          <ul class="text-xs sm:text-sm text-slate-700 space-y-1">
            ${notes.map(n => `<li>${n}</li>`).join('')}
          </ul>
        </div>
      `;
      document.getElementById('praktikum-feedback-box').innerHTML = praktikumFeedbackHTML;
    }

