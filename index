    function setReflectionConfidence(val) {
      appState.reflection.q1 = document.getElementById('ref_q1')?.value || appState.reflection.q1;
      appState.reflection.q2 = document.getElementById('ref_q2')?.value || appState.reflection.q2;
      appState.reflection.q3 = document.getElementById('ref_q3')?.value || appState.reflection.q3;
      appState.reflection.confidence = val;
      playSFX('click');
      renderCurrentView();
    }

    function saveStudentReflection() {
      appState.reflection.q1 = document.getElementById('ref_q1')?.value || '';
      appState.reflection.q2 = document.getElementById('ref_q2')?.value || '';
      appState.reflection.q3 = document.getElementById('ref_q3')?.value || '';
      appState.reflection.saved = true;
      saveState();
      playSFX('win');
      renderCurrentView();
      showToast('Terima kasih! Refleksi pembelajaranmu telah tersimpan.', 'success');
    }

    function resetAllAppProgress() {
      showConfirm(
        'Reset Seluruh Data Pembelajaran',
        'Semua progres materi, skor game, jawaban praktikum, LKPD, evaluasi, dan refleksi akan dihapus dari browser ini. Lanjutkan?',
        () => {
          localStorage.removeItem(STORAGE_KEY);
          appState = JSON.parse(JSON.stringify(defaultState));
          evalState = { started: false, submitted: false, currentIdx: 0, answers: {}, timeLeftSec: 1800, timerInterval: null };
          activeGameId = null;
          navigateTo('landing');
          showToast('Seluruh data sesi berhasil di-reset.', 'info');
        }
      );
    }

    /* =====================================================================
       15. HTML ESCAPE HELPERS & INITIAL BOOTSTRAP
       ===================================================================== */
    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function escapeAttr(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    // Boot application on load
    window.addEventListener('DOMContentLoaded', () => {
      navigateTo(appState.currentView || 'landing');
    });
  </script>
