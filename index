                      ${q.options.map((opt, oIdx) => {
                        let cls = 'bg-white hover:bg-royal-50 border-slate-300 text-slate-700';
                        if (chosen !== undefined) {
                          if (oIdx === q.answer) cls = 'bg-emerald-600 border-emerald-600 text-white font-bold';
                          else if (oIdx === chosen) cls = 'bg-rose-600 border-rose-600 text-white';
                        }
                        return `
