    /* =====================================================================
       5. NAVIGATION & VIEW ROUTER
       ===================================================================== */
    function navigateTo(viewName, scrollToReflection = false) {
      stopSpeech();
      playSFX('click');
      appState.currentView = viewName;
      saveState();

      const header = document.getElementById('app-header');
      const footer = document.getElementById('app-footer');

      if (viewName === 'landing') {
        header.classList.add('hidden');
        footer.classList.add('hidden');
      } else {
        header.classList.remove('hidden');
        footer.classList.remove('hidden');
      }

      updateAudioButtonUI();
      updateGlobalProgressUI();
      renderCurrentView();
      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (scrollToReflection && viewName === 'developer') {
        setTimeout(() => {
          const el = document.getElementById('reflection-section');
          if (el) el.scrollIntoView({ behavior: 'smooth' });
        }, 120);
      }
    }

    function navHistoryBack() {
      const seq = appState.navSequence;
      const idx = seq.indexOf(appState.currentView);
      if (idx > 0) {
        navigateTo(seq[idx - 1]);
      } else {
        navigateTo('menu');
      }
    }

    function navHistoryNext() {
      const seq = appState.navSequence;
      const idx = seq.indexOf(appState.currentView);
      if (idx >= 0 && idx < seq.length - 1) {
        navigateTo(seq[idx + 1]);
      } else {
        navigateTo('menu');
      }
    }

    function renderCurrentView() {
      const viewport = document.getElementById('app-viewport');
      if (!viewport) return;

      switch (appState.currentView) {
        case 'landing':
          viewport.innerHTML = renderLandingView();
          break;
        case 'menu':
          viewport.innerHTML = renderMainMenuView();
          break;
        case 'materi':
          viewport.innerHTML = renderMateriView();
          break;
        case 'simulasi':
          viewport.innerHTML = renderSimulasiView();
          break;
        case 'praktikum':
          viewport.innerHTML = renderPraktikumView();
          break;
        case 'game':
          viewport.innerHTML = renderGameHubView();
          break;
        case 'lkpd':
          viewport.innerHTML = renderLKPDView();
          break;
        case 'evaluasi':
          viewport.innerHTML = renderEvaluasiView();
          break;
        case 'developer':
          viewport.innerHTML = renderDeveloperView();
          break;
        default:
          viewport.innerHTML = renderLandingView();
      }
    }

