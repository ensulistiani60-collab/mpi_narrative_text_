    function selectMateriSub(i) {
      stopSpeech();
      appState.materiSubIndex = i;
      saveState();
      renderCurrentView();
    }

    function prevMateriSub() {
      if (appState.materiSubIndex > 0) {
        selectMateriSub(appState.materiSubIndex - 1);
      }
    }

    function nextMateriSub() {
      appState.materiCompleted[appState.materiSubIndex] = true;
      if (appState.materiSubIndex < MATERI_CHAPTERS.length - 1) {
        selectMateriSub(appState.materiSubIndex + 1);
      }
    }

    function completeCurrentMateriSub() {
      appState.materiCompleted[appState.materiSubIndex] = true;
      playSFX('correct');
      saveState();
      renderCurrentView();
      showToast('Progres sub-bab materi disimpan!', 'success');
    }

    function answerMateriQuiz(chapId, qIdx, chosenIdx, correctIdx) {
      const key = `${chapId}_${qIdx}`;
      appState.materiQuizAnswers[key] = chosenIdx;
      if (chosenIdx === correctIdx) {
        playSFX('correct');
      } else {
        playSFX('wrong');
      }
      saveState();
      renderCurrentView();
    }

