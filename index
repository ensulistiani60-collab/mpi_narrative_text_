              </div>
              <div class="bg-gold-100 text-navy-900 px-4 py-2 rounded-2xl font-extrabold text-sm">
                Skor: ${calculateSimulasiScore()} / 5
              </div>
            </div>

            <div class="space-y-5">
              ${story.comprehensionQuiz.map((q, qIdx) => {
                const chosen = appState.simulasiAnswers[q.id];
                return `
                  <div class="bg-slate-50 rounded-2xl p-4 sm:p-5 border border-slate-200 space-y-3">
                    <div class="flex items-center gap-2">
                      <span class="px-2.5 py-0.5 rounded-lg bg-royal-700 text-white text-xs font-bold">${q.category}</span>
