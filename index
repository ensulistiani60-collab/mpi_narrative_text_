    function toggleSimTranslation() {
      showSimTranslation = !showSimTranslation;
      renderCurrentView();
    }

    function calculateSimulasiScore() {
      let score = 0;
      SIMULATION_STORY.comprehensionQuiz.forEach(q => {
        if (appState.simulasiAnswers[q.id] === q.answer) score++;
      });
      return score;
    }

    function answerSimulasi(qId, chosenIdx, correctIdx) {
      appState.simulasiAnswers[qId] = chosenIdx;
      if (chosenIdx === correctIdx) playSFX('correct');
      else playSFX('wrong');

      if (Object.keys(appState.simulasiAnswers).length === SIMULATION_STORY.comprehensionQuiz.length) {
        appState.simulasiCompleted = true;
      }
      saveState();
      renderCurrentView();
    }

    function resetSimulasi() {
      appState.simulasiAnswers = {};
      appState.simulasiCompleted = false;
      saveState();
      renderCurrentView();
      showToast('Latihan simulasi telah di-reset.', 'info');
    }

