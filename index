                  <div class="bg-white/10 p-3 rounded-xl border border-white/10">
                    <span class="text-slate-400 block">Institusi</span>
                    <strong class="text-white text-sm">SMK Perintis Adiluhur</strong>
                  </div>
                  <div class="bg-white/10 p-3 rounded-xl border border-white/10">
                    <span class="text-slate-400 block">Mata Pelajaran & Kelas</span>
                    <strong class="text-white text-sm">Bahasa Inggris • XI Fase F</strong>
                  </div>
                  <div class="bg-white/10 p-3 rounded-xl border border-white/10">
                    <span class="text-slate-400 block">Materi & Tahun Pelajaran</span>
                    <strong class="text-white text-sm">Narrative Text • 2026/2027</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Learning Summary Report Card -->
          <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-md space-y-5">
            <h3 class="text-xl font-bold text-navy-900 flex items-center gap-2">
              <span>📊</span> Ringkasan Hasil Belajar Siswa
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div class="bg-royal-50 border border-royal-200 p-4 rounded-2xl text-center">
                <p class="text-xs font-bold text-royal-800 uppercase">Progres Total</p>
                <p class="text-2xl font-extrabold text-royal-950 mt-1">${overallPct}%</p>
              </div>
              <div class="bg-sky-50 border border-sky-200 p-4 rounded-2xl text-center">
                <p class="text-xs font-bold text-sky-800 uppercase">Materi Selesai</p>
                <p class="text-2xl font-extrabold text-sky-950 mt-1">${appState.materiCompleted.filter(Boolean).length}/5</p>
              </div>
              <div class="bg-amber-50 border border-amber-200 p-4 rounded-2xl text-center">
                <p class="text-xs font-bold text-amber-800 uppercase">Rata-Rata Game</p>
                <p class="text-2xl font-extrabold text-amber-950 mt-1">${avgGame}%</p>
              </div>
              <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-2xl text-center">
                <p class="text-xs font-bold text-emerald-800 uppercase">Skor Evaluasi</p>
