    function checkLKPD() {
      syncLKPDInputs();
      const d = appState.lkpdData;
      let pts = 0;
      const maxPts = 9;

      // 1. Characters
      if (d.q1_chars.toLowerCase().includes('sekar') || d.q1_chars.toLowerCase().includes('heron')) pts++;
      // 2. Setting
      if (d.q2_setting.toLowerCase().includes('valley') || d.q2_setting.toLowerCase().includes('java') || d.q2_setting.toLowerCase().includes('river')) pts++;
      // 3-6. Matching
      if (d.q3_m1 === 'Orientation') pts++;
      if (d.q3_m2 === 'Complication') pts++;
      if (d.q3_m3 === 'Resolution') pts++;
      if (d.q3_m4 === 'Reorientation / Coda') pts++;
      // 7. Moral
      if (d.q5_moral === 'A') pts++;
      // 8-9. Verb 2 from text
      const validVerbs = ['lived', 'wove', 'rescued', 'bandaged', 'cared', 'could', 'struck', 'ran', 'returned', 'planted', 'grew', 'saved', 'shared'];
      if (validVerbs.includes(d.q4_verb1.trim().toLowerCase())) pts++;
      if (validVerbs.includes(d.q4_verb2.trim().toLowerCase()) && d.q4_verb2.trim().toLowerCase() !== d.q4_verb1.trim().toLowerCase()) pts++;

      d.checked = true;
      d.score = Math.round((pts / maxPts) * 100);
      saveState();
      playSFX(d.score >= 70 ? 'correct' : 'wrong');
      renderCurrentView();
      showToast(`Pemeriksaan selesai! Skor objektif LKPD: ${d.score}%`, 'info');
    }

